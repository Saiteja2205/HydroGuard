# ================================
# HydroGuard - Git Ignore
# ================================

# --------------------------------
# Python
# --------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --------------------------------
# Environment / Secrets
# --------------------------------
.env
.env.*
!.env.example

# --------------------------------
# FastAPI / Backend
# --------------------------------
*.log

# Local databases
*.db
*.sqlite
*.sqlite3

# --------------------------------
# Jupyter
# --------------------------------
.ipynb_checkpoints/

# --------------------------------
# Android / Gradle
# --------------------------------
.gradle/
**/build/
**/.gradle/

# Android Studio
.idea/
*.iml

# Local Android SDK configuration
local.properties

# --------------------------------
# Kotlin
# --------------------------------
*.class

# --------------------------------
# Generated APKs
# --------------------------------
*.apk
*.aab

# --------------------------------
# OS files
# --------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------
# Temporary / backup files
# --------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo

# --------------------------------
# Editor files
# --------------------------------
.vscode/

# --------------------------------
# Node
# --------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --------------------------------
# Large temporary exports
# --------------------------------
*.zip
*.rar
*.7z