<?xml version="1.0" encoding="utf-8"?>
<!--
  Water-quality metric tile.

  Label 12sp slate, value JetBrains Mono 600 (tabular figures so 6.4 and 1180
  occupy predictable width and the five tiles do not reflow as values tick),
  acceptable band and state at 11sp. The label is deliberately NOT the uppercase
  Label tier: this set contains "pH", and uppercasing it produces "PH", which is
  wrong for a chemistry term.

  Tile width and horizontal gaps are assigned by WaterScreen, which groups these
  into rows of two; here the tile only declares its own surface, padding and
  minimum height.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/hydroguard_tile"
    android:minHeight="@dimen/metric_min_height"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <TextView
        android:id="@+id/metric_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/hydroguard_sans"
        android:includeFontPadding="false"
        android:textColor="@color/hydroguard_muted"
        android:textFontWeight="500"
        android:textSize="@dimen/type_label" />

    <TextView
        android:id="@+id/metric_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/hydroguard_mono"
        android:includeFontPadding="false"
        android:textColor="@color/hydroguard_text"
        android:textFontWeight="600"
        android:textSize="@dimen/type_reading" />

    <TextView
        android:id="@+id/metric_threshold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/hydroguard_sans"
        android:includeFontPadding="false"
        android:textColor="@color/hydroguard_muted"
        android:textFontWeight="400"
        android:textSize="@dimen/type_micro" />

    <TextView
        android:id="@+id/metric_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/hydroguard_sans"
        android:includeFontPadding="false"
        android:textFontWeight="500"
        android:textSize="@dimen/type_micro" />
</LinearLayout>
