<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report a hostel issue"
            android:textColor="@color/hydroguard_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <Spinner android:id="@+id/issue_category" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/issue_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room or location"
            android:inputType="textCapSentences"
            android:minHeight="56dp" />
        <Spinner android:id="@+id/issue_severity" android:layout_width="match_parent" android:layout_height="52dp" />
        <EditText
            android:id="@+id/issue_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="Describe the issue"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="110dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit_issue"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Submit report"
            android:textAllCaps="false" />
        <TextView
            android:id="@+id/issue_form_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/hydroguard_muted"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hostel feedback"
            android:textColor="@color/hydroguard_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <Spinner android:id="@+id/feedback_category" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" />
        <Spinner android:id="@+id/feedback_rating" android:layout_width="match_parent" android:layout_height="52dp" />
        <EditText
            android:id="@+id/feedback_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="Your feedback (optional)"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="72dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit_feedback"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Send feedback"
            android:textAllCaps="false" />
        <TextView android:id="@+id/feedback_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/hydroguard_muted" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
