<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/marker_background"
    android:elevation="4dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/marker_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/hydroguard_mono"
        android:textColor="@color/hydroguard_navy_on"
        android:textFontWeight="700"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/marker_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/hydroguard_sans"
        android:textColor="@color/hydroguard_link_unknown"
        android:textSize="11sp" />
</LinearLayout>
