<?xml version="1.0" encoding="utf-8"?>
<!--
  HydroGuard Student Login Screen.
  Substantial, vertically balanced layout with high-contrast elevated card,
  clear student authentication instructions, and responsive scaling.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hydroguard_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- Prominent Brand Lockup -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="HydroGuard water drop"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/hydroguard_sans"
                android:letterSpacing="0.14"
                android:text="HYDROGUARD"
                android:textColor="@color/hydroguard_teal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/hydroguard_sans"
                android:text="Hostel Water Quality Intelligence"
                android:textColor="@color/hydroguard_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Substantial Login Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/hydroguard_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/hydroguard_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Card Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hydroguard_sans"
                    android:text="@string/login_title"
                    android:textColor="@color/hydroguard_navy"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/hydroguard_sans"
                    android:lineSpacingExtra="2dp"
                    android:text="Sign in with your verified college Google account to access live hostel tank readings and campus services."
                    android:textColor="@color/hydroguard_muted"
                    android:textSize="13sp" />

                <!-- Card-level status strip for errors or notifications -->
                <TextView
                    android:id="@+id/login_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/hydroguard_tile"
                    android:fontFamily="@font/hydroguard_sans"
                    android:lineSpacingExtra="2dp"
                    android:padding="10dp"
                    android:textColor="@color/hydroguard_text"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Indeterminate progress bar active only during session verification or auth calls -->
                <ProgressBar
                    android:id="@+id/login_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/hydroguard_blue"
                    android:visibility="gone" />

                <!-- Google Sign-In Primary Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/google_sign_in"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:contentDescription="Sign in with Google"
                    android:fontFamily="@font/hydroguard_sans"
                    android:text="@string/sign_in_with_google"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textFontWeight="600"
                    android:textSize="15sp"
                    app:backgroundTint="@color/hydroguard_blue"
                    app:cornerRadius="12dp" />

                <!-- Domain trust notice inside the card -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/hydroguard_sans"
                    android:gravity="center"
                    android:text="Authorized college domains only · Student access"
                    android:textColor="@color/hydroguard_muted"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
