<?xml version="1.0" encoding="utf-8"?>
<!--
  Water dashboard.

  Structure follows the approved reference: a provenance/status card, a discrete
  telemetry grid (five measurements as five tiles, not five rows inside one
  container), then the index, history, forecast and alerts as labelled sections.

  Everything id-bearing keeps its exact id and type — reading_status,
  metric_cards (still a LinearLayout; WaterScreen now fills it with rows of two),
  index_summary, the chart ids, alerts_list/alerts_status and all of
  admin_controls — so the Java in WaterScreen is unchanged apart from the grid
  grouping.

  Nothing fabricated is present: no capacity percentage, inflow/outflow, tank
  autonomy, RO-plant status or sanitisation countdown, none of which this
  backend serves. Every value on the screen comes from a reading, a threshold,
  a forecast or an alert the API returned.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/water_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/section_gap">

            <!-- ============================ Live reading ============================ -->

            <TextView
                style="@style/TextAppearance.HydroGuard.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Live water quality"
                android:textColor="@color/hydroguard_text" />

            <TextView
                android:id="@+id/sensor_status"
                style="@style/TextAppearance.HydroGuard.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hydroguard_muted" />

            <Spinner
                android:id="@+id/node_selector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:contentDescription="Select a sensor node" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/hydroguard_surface"
                app:cardCornerRadius="@dimen/corner_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/hydroguard_divider"
                app:strokeWidth="@dimen/border_hairline">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">
                    <TextView
                        android:id="@+id/reading_status"
                        style="@style/TextAppearance.HydroGuard.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Connect to HydroGuard to load readings."
                        android:textColor="@color/hydroguard_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Telemetry grid: WaterScreen lays these out two per row. -->
            <LinearLayout
                android:id="@+id/metric_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:orientation="vertical" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                app:cardBackgroundColor="@color/hydroguard_surface"
                app:cardCornerRadius="@dimen/corner_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/hydroguard_divider"
                app:strokeWidth="@dimen/border_hairline">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">
                    <TextView
                        android:id="@+id/index_summary"
                        style="@style/TextAppearance.HydroGuard.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hydroguard_text" />
                    <TextView
                        style="@style/TextAppearance.HydroGuard.Micro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Application indicator only; it is not a drinking-water safety standard."
                        android:textColor="@color/hydroguard_muted"
                        android:textFontWeight="400" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================ History ============================ -->

            <TextView
                style="@style/TextAppearance.HydroGuard.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="Reading history"
                android:textColor="@color/hydroguard_text" />

            <!-- Parameter caption. The count is written by WaterScreen from
                 METRICS.length, so it can never claim more series than the app
                 actually offers. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.HydroGuard.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parameter"
                    android:textColor="@color/hydroguard_muted" />

                <TextView
                    android:id="@+id/history_parameter_count"
                    style="@style/TextAppearance.HydroGuard.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/hydroguard_blue" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/history_parameter_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipStyle="@style/Widget.HydroGuard.Chip"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <!-- Time horizon: a segmented controller, not a second chip row. The
                 buttons are declared here (with the initial check in XML) so the
                 first selection is set without firing a second history load. -->
            <TextView
                style="@style/TextAppearance.HydroGuard.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Time range"
                android:textColor="@color/hydroguard_muted" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="@color/hydroguard_subsurface"
                app:cardCornerRadius="@dimen/corner_card"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/history_range_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    app:checkedButton="@id/range_7d"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/range_24h"
                        style="@style/Widget.HydroGuard.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="24 hours"
                        android:checkable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/range_7d"
                        style="@style/Widget.HydroGuard.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="7 days"
                        android:checkable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/range_30d"
                        style="@style/Widget.HydroGuard.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="30 days"
                        android:checkable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/range_all"
                        style="@style/Widget.HydroGuard.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="All"
                        android:checkable="true" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                app:cardBackgroundColor="@color/hydroguard_surface"
                app:cardCornerRadius="@dimen/corner_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/hydroguard_divider"
                app:strokeWidth="@dimen/border_hairline">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_compact">

                    <!-- Names the series and the horizon, which the status line
                         below it does not. -->
                    <TextView
                        android:id="@+id/history_chart_title"
                        style="@style/TextAppearance.HydroGuard.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hydroguard_text" />

                    <TextView
                        android:id="@+id/history_chart_status"
                        style="@style/TextAppearance.HydroGuard.Micro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/hydroguard_muted" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/history_chart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/chart_height"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================ Forecast ============================ -->

            <TextView
                style="@style/TextAppearance.HydroGuard.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="24-hour forecast"
                android:textColor="@color/hydroguard_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/load_forecast"
                style="@style/Widget.HydroGuard.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Generate next-day forecast" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/load_thingspeak_forecast"
                style="@style/Widget.HydroGuard.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Generate ThingSpeak forecast" />

            <!-- Forecast notice card. forecast_status keeps its id and every one
                 of its existing loading / error / result strings; only its frame
                 changes. The provenance badge stays hidden until a forecast has
                 actually returned, so a failure never wears a label it did not earn. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                app:cardBackgroundColor="@color/hydroguard_subsurface"
                app:cardCornerRadius="@dimen/corner_card"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_compact">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_hydroguard_pulse"
                            android:tint="@color/hydroguard_blue" />

                        <TextView
                            style="@style/TextAppearance.HydroGuard.BodyStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Forecast details"
                            android:textColor="@color/hydroguard_text" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/forecast_source_badge"
                            style="@style/Widget.HydroGuard.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/hydroguard_provenance_forecast_bg"
                            android:textColor="@color/hydroguard_provenance_forecast"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/forecast_status"
                        style="@style/TextAppearance.HydroGuard.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="No forecast has been generated for this node yet."
                        android:textColor="@color/hydroguard_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/forecast_chart_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:visibility="gone"
                app:cardBackgroundColor="@color/hydroguard_surface"
                app:cardCornerRadius="@dimen/corner_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/hydroguard_divider"
                app:strokeWidth="@dimen/border_hairline">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_compact">

                    <!-- The card title leads, then the legend sits directly above the
                         chart it explains - the reference's order. -->
                    <TextView
                        android:id="@+id/forecast_chart_title"
                        style="@style/TextAppearance.HydroGuard.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/hydroguard_text" />

                    <!-- Provenance legend. This is the one thing the chart cannot
                         say on its own: which line is measured and which is modelled.
                         Every badge text comes from a real field of a real response
                         (the reading's source, the forecast's data_source, the
                         configured threshold), so no confidence figure, model version
                         or bound is ever displayed that the server did not send. -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/forecast_legend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="@color/hydroguard_background"
                        app:cardCornerRadius="@dimen/corner_control"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/TextAppearance.HydroGuard.Micro"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Observed readings"
                                    android:textColor="@color/hydroguard_text" />

                                <TextView
                                    android:id="@+id/legend_observed_badge"
                                    style="@style/Widget.HydroGuard.Pill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:backgroundTint="@color/hydroguard_provenance_unknown_bg"
                                    android:textColor="@color/hydroguard_provenance_unknown"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/TextAppearance.HydroGuard.Micro"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Predicted value"
                                    android:textColor="@color/hydroguard_text" />

                                <TextView
                                    android:id="@+id/legend_forecast_badge"
                                    style="@style/Widget.HydroGuard.Pill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:backgroundTint="@color/hydroguard_provenance_forecast_bg"
                                    android:text="FORECAST"
                                    android:textColor="@color/hydroguard_provenance_forecast" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/legend_threshold_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/legend_threshold_label"
                                    style="@style/TextAppearance.HydroGuard.Micro"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="@color/hydroguard_text" />

                                <TextView
                                    android:id="@+id/legend_threshold_badge"
                                    style="@style/Widget.HydroGuard.Pill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:backgroundTint="@color/hydroguard_critical_surface"
                                    android:textColor="@color/hydroguard_critical_text" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/forecast_chart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/chart_height" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================ Alerts ============================ -->

            <TextView
                style="@style/TextAppearance.HydroGuard.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="Alerts"
                android:textColor="@color/hydroguard_text" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/alerts_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/alerts_status"
                style="@style/TextAppearance.HydroGuard.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hydroguard_muted" />

            <!-- ============================ Administrator controls ============================ -->

            <LinearLayout
                android:id="@+id/admin_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.HydroGuard.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:text="Administrator controls"
                    android:textColor="@color/hydroguard_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edit_thresholds"
                    style="@style/Widget.HydroGuard.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Edit alert thresholds" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/export_csv"
                    style="@style/Widget.HydroGuard.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Export historical report (CSV)" />

                <TextView
                    android:id="@+id/export_status"
                    style="@style/TextAppearance.HydroGuard.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/hydroguard_muted" />

                <LinearLayout
                    android:id="@+id/sensor_health_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
