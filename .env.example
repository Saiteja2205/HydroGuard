# HydroGuard development settings template.
# Copy to .dev-auth.env (git-ignored) and fill in real values.
# The backend reads these through the environment; scripts/run-development.ps1 loads .dev-auth.env.

# Backend
HYDROGUARD_ENVIRONMENT=development
HYDROGUARD_ENABLE_DEV_AUTH=true
HYDROGUARD_DEV_API_TOKEN=change-me-long-random-secret
HYDROGUARD_SENSOR_API_KEY=change-me-sensor-token
HYDROGUARD_FIREBASE_PROJECT_ID=hydroguard-4a606
HYDROGUARD_ALLOWED_STUDENT_DOMAINS=your.edu.example
# Optional explicit database path (defaults to hydroguard-backend/data/hydroguard.db)
# HYDROGUARD_DATABASE_PATH=

# Android debug build (Gradle property or environment variable)
# Emulator against this PC: http://10.0.2.2:8000/  |  Physical device: http://<PC-LAN-IP>:8000/
HYDROGUARD_API_BASE_URL=http://10.0.2.2:8000/

# Android release build (must be a public HTTPS host; validated by validateReleaseConfiguration)
# HYDROGUARD_RELEASE_API_BASE_URL=https://api.example.org/
# KEYSTORE_PATH, STORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD supplied via CI environment variables.
