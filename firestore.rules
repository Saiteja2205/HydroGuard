rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // HydroGuard currently uses Firebase Authentication for identity only.
    // Application data is served by FastAPI and stored in the backend database;
    // sensor writes use the backend's X-Sensor-Token check. No current Android
    // or backend code reads or writes Cloud Firestore, so no client role needs
    // Firestore permissions. Admin authorization remains in FastAPI, where
    // server-verified Firebase role claims protect admin endpoints.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
